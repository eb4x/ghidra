<?xml version="1.0" encoding="UTF-8"?>

<compiler_spec>

  <data_organization>
	<absolute_max_alignment value="0" /> <!-- no maximum alignment -->
	<machine_alignment value="2" />
	<default_alignment value="1" />
	<default_pointer_alignment value="2" />
	<pointer_size value="2" /> <!-- near pointer, TODO: how do we define far 4-byte pointer? -->
	<wchar_size value="2" />
	<short_size value="2" />
	<integer_size value="2" />
	<long_size value="4" />
	<long_long_size value="4" />
	<float_size value="4" />
	<double_size value="8" />
	<long_double_size value="10" />
	<!-- 16-bit compilers align to at most a 2-byte (word) boundary: the stack is
	     2-byte granular, and Microsoft C packs structures at 2 bytes by default
	     (/Zp2) while Borland packs at 1 (-a-).  Without this map the default
	     4/8-byte alignments apply, padding stack parameters larger than 2 bytes
	     onto 4-byte boundaries no 16-bit compiler uses. -->
	<size_alignment_map>
		<entry size="1" alignment="1" />
		<entry size="2" alignment="2" />
		<entry size="4" alignment="2" />
		<entry size="8" alignment="2" />
	</size_alignment_map>
  </data_organization>
  
  <global>
    <range space="ram"/>
  </global>
  <stackpointer register="SP" space="ram"/>
  <default_proto>
    <prototype name="__stdcall16near" extrapop="unknown" stackshift="2">
      <input>
        <pentry minsize="1" maxsize="500" align="2">
          <addr offset="2" space="stack"/>
        </pentry>
      </input>
      <output>
        <pentry minsize="1" maxsize="2">
          <register name="AX"/>
        </pentry>
        <pentry minsize="3" maxsize="4">
          <addr space="join" piece1="DX" piece2="AX"/>
        </pentry>
      </output>
      <unaffected>
        <register name="SP"/>
        <register name="BP"/>
        <register name="SI"/>
        <register name="DI"/>
        <register name="DS"/>
        <register name="CS"/>
        <register name="ES"/>
        <register name="SS"/>
        <register name="DF"/>
      </unaffected>
    </prototype>
  </default_proto>
  <prototype name="__cdecl16near" extrapop="2" stackshift="2">
    <input>
      <pentry minsize="1" maxsize="500" align="2">
        <addr offset="2" space="stack"/>
      </pentry>
    </input>
    <output>
        <pentry minsize="1" maxsize="2">
          <register name="AX"/>
        </pentry>
        <pentry minsize="3" maxsize="4">
          <addr space="join" piece1="DX" piece2="AX"/>
        </pentry>
    </output>
    <unaffected>
      <register name="SP"/>
      <register name="BP"/>
      <register name="SI"/>
      <register name="DI"/>
      <register name="DS"/>
      <register name="CS"/>
      <register name="ES"/>
      <register name="SS"/>
      <register name="DF"/>
    </unaffected>
  </prototype>
  <prototype name="__stdcall16far" extrapop="unknown" stackshift="4">
    <input>
      <pentry minsize="1" maxsize="500" align="2">
        <addr offset="4" space="stack"/>
      </pentry>
    </input>
    <output>
        <pentry minsize="1" maxsize="2">
          <register name="AX"/>
        </pentry>
        <pentry minsize="3" maxsize="4">
          <addr space="join" piece1="DX" piece2="AX"/>
        </pentry>
    </output>
    <unaffected>
      <register name="SP"/>
      <register name="BP"/>
      <register name="SI"/>
      <register name="DI"/>
      <register name="DS"/>
      <register name="CS"/>
      <register name="ES"/>
      <register name="SS"/>
      <register name="DF"/>
    </unaffected>
  </prototype>
  <prototype name="__cdecl16far" extrapop="4" stackshift="4">
    <input>
      <pentry minsize="1" maxsize="500" align="2">
        <addr offset="4" space="stack"/>
      </pentry>
    </input>
    <output>
      <pentry minsize="1" maxsize="2">
        <register name="AX"/>
      </pentry>
      <pentry minsize="3" maxsize="4">
        <addr space="join" piece1="DX" piece2="AX"/>
      </pentry>
    </output>
    <unaffected>
      <register name="SP"/>
      <register name="BP"/>
      <register name="SI"/>
      <register name="DI"/>
      <register name="DS"/>
      <register name="CS"/>
      <register name="ES"/>
      <register name="SS"/>
      <register name="DF"/>
    </unaffected>
  </prototype>
  <prototype name="__regcall" extrapop="2" stackshift="2">
    <input>
      <pentry minsize="1" maxsize="2">
        <register name="AX"/>
      </pentry>
      <pentry minsize="1" maxsize="2">
        <register name="BX"/>
      </pentry>
      <pentry minsize="1" maxsize="2">
        <register name="CX"/>
      </pentry>
      <pentry minsize="1" maxsize="2">
        <register name="DX"/>
      </pentry>
    </input>
    <output>
        <pentry minsize="1" maxsize="2">
          <register name="AX"/>
        </pentry>
        <pentry minsize="3" maxsize="4">
          <addr space="join" piece1="DX" piece2="AX"/>
        </pentry>
    </output>
    <unaffected>
      <register name="SP"/>
      <register name="BP"/>
      <register name="CX"/>
      <register name="DX"/>
      <register name="SI"/>
      <register name="DI"/>
      <register name="DS"/>
      <register name="CS"/>
      <register name="ES"/>
      <register name="SS"/>
      <register name="DF"/>
    </unaffected>
  </prototype>
  <prototype name="__regcall16far" extrapop="4" stackshift="4">
    <input>
      <pentry minsize="1" maxsize="2">
        <register name="AX"/>
      </pentry>
      <pentry minsize="1" maxsize="2">
        <register name="BX"/>
      </pentry>
      <pentry minsize="1" maxsize="2">
        <register name="CX"/>
      </pentry>
      <pentry minsize="1" maxsize="2">
        <register name="DX"/>
      </pentry>
      <pentry minsize="1" maxsize="500" align="2">
        <addr offset="4" space="stack"/>
      </pentry>
    </input>
    <output>
        <pentry minsize="1" maxsize="2">
          <register name="AX"/>
        </pentry>
        <pentry minsize="3" maxsize="4">
          <addr space="join" piece1="DX" piece2="AX"/>
        </pentry>
    </output>
    <unaffected>
      <register name="SP"/>
      <register name="BP"/>
      <register name="CX"/>
      <register name="DX"/>
      <register name="SI"/>
      <register name="DI"/>
      <register name="DS"/>
      <register name="CS"/>
      <register name="ES"/>
      <register name="SS"/>
      <register name="DF"/>
    </unaffected>
  </prototype>
  <!-- Microsoft C's stack probe: called on entry with the frame size in AX, it
       returns with SP lowered by AX.  The call's return address push stays in the
       p-code, so add it back.  __chkstk (also matched as _chkstk) is far in the
       medium, large and huge models; small and compact-model programs set
       chkstk16near on the function by hand. -->
  <callfixup name="chkstk16far">
    <target name="__chkstk"/>
    <target name="__aFchkstk"/>
    <pcode>
      <body><![CDATA[
        SP = SP + 4 - AX;
      ]]></body>
    </pcode>
  </callfixup>
  <callfixup name="chkstk16near">
    <target name="__aNchkstk"/>
    <pcode>
      <body><![CDATA[
        SP = SP + 2 - AX;
      ]]></body>
    </pcode>
  </callfixup>
</compiler_spec>
